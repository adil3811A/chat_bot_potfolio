# Copy to .env and fill in — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional overrides
# GEMINI_MODEL=gemini-3.6-flash
# PORT=3000
# LOG_LEVEL=info

# Browser origins allowed to call /api (comma-separated). Defaults to the
# portfolio site + http://localhost:8000 when unset.
# ALLOWED_ORIGINS=https://adil-ansari-portfolio-web.web.app,https://adil-ansari-portfolio-web.firebaseapp.com,http://localhost:8000
