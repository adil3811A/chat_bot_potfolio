# --- Groq (text model) ---
# Get a key at https://console.groq.com/keys (free tier available)
GROQ_API_KEY=gsk_...

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# PORT=3000
# LOG_LEVEL=info

# Browser origins allowed to call /api (comma-separated).
# ALLOWED_ORIGINS=https://adil-ansari-portfolio-web.web.app,https://adil-ansari-portfolio-web.firebaseapp.com

# --- Firestore (live career metrics) ---
# Optional: without it the bot answers from the static profile only.
#
# Local dev — path to the service-account JSON
#   (Firebase console → Project settings → Service accounts → Generate new private key)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#
# Vercel / serverless — paste the same JSON as a single-line string instead
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#
# FIREBASE_PROJECT_ID=adil-ansari-portfolio-web
# FIRESTORE_COLLECTION=portfolio
# FIRESTORE_DOCUMENT=career_details
# CAREER_CACHE_TTL_MS=300000
